# Copy to .env and replace every placeholder before exposing this service.
# Docker Compose reads this file. Native development should export
# DEBUG=True and use localhost database/Redis URLs instead of the Compose
# service hostnames.

SECRET_KEY=replace-me-with-a-long-random-value
DEBUG=False
PULSE_VERSION=1.1.0
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Local Compose topology. For native development use localhost instead of
# db/redis/mailpit, or override on the command line.
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/pulse
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Optional Compose overrides for external services. Leave blank to use the
# bundled db, redis and Mailpit containers.
COMPOSE_DATABASE_URL=
COMPOSE_REDIS_URL=
COMPOSE_CELERY_BROKER_URL=
COMPOSE_CELERY_RESULT_BACKEND=
COMPOSE_EMAIL_HOST=
COMPOSE_EMAIL_PORT=

# Comma-separated client API keys. Leave empty to reject API-key requests;
# browser operators can still sign in with a JWT account.
PULSE_API_KEYS=replace-with-a-long-random-api-key
ALLOW_REGISTRATION=False
API_THROTTLE_RATE=

# Set these to true only behind an HTTPS reverse proxy.
SECURE_SSL_REDIRECT=False
TRUST_X_FORWARDED_PROTO=False
SESSION_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CSRF_COOKIE_SECURE=False

ENABLE_DOCS=True

# Mailpit for local development.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=pulse@local.dev

# SMS (optional). Without these, SMS sends fail permanently with a clear error.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Push: "console" simulates delivery; set to "fcm" with Firebase credentials
# (FIREBASE_CREDENTIALS_FILE or application default credentials) for live push.
PUSH_BACKEND=console
FIREBASE_CREDENTIALS_FILE=

NEXT_PUBLIC_ENVIRONMENT=Self-hosted
