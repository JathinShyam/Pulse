      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "401 branch: the proxy calls /api/auth/refresh/ with the refresh cookie, rotates both cookies, and retries the original request once. A failed refresh clears the session.",
      "roughness": 1,
      "roundness": null,
      "seed": 1109512761,
      "strokeColor": "#495057",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "401 branch: the proxy calls /api/auth/refresh/ with the refresh cookie, rotates both cookies, and retries the original request once. A failed refresh clears the session.",
      "textAlign": "left",
      "updated": 1792749124037,
      "version": 1,
      "versionNonce": 1111508379,
      "verticalAlign": "top"
    },
    {
      "id": "note-2",
      "type": "text",
      "x": 105,
      "y": 1148,
      "width": 1431,
      "height": 20,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 1,
