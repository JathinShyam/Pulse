      "groupIds": [],
      "index": "aA",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Protected routes: missing access and refresh cookies redirect to /login?next=...; opening /login with an access cookie redirects back to the console.",
      "roughness": 1,
      "roundness": null,
      "seed": 2020802,
      "strokeColor": "#495057",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Protected routes: missing access and refresh cookies redirect to /login?next=...; opening /login with an access cookie redirects back to the console.",
      "textAlign": "left",
      "updated": 1792749124037,
      "version": 1,
      "versionNonce": 798359566,
      "verticalAlign": "top"
    },
    {
