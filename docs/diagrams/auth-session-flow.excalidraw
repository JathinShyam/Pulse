      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "API clients bypass the proxy with X-API-Key. Browser JavaScript never sees JWTs: cookies are httpOnly, SameSite=Lax, and Secure over HTTPS.",
      "roughness": 1,
      "roundness": null,
      "seed": 1811377433,
      "strokeColor": "#495057",
